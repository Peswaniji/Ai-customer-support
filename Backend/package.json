{
  "name": "ai-csp-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/config/seed.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check \"src/**/*.js\"",
    "format:fix": "prettier --write \"src/**/*.js\"",
    "check": "npm run lint && npm run format"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "nodemailer": "^8.0.7",
    "redis": "^5.12.1",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.8.3"
  }
}
